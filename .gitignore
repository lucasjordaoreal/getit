**/tools/**/Bin/

# Project-specific generated outputs
installer/**/*.exe
installer/**/*.msi
installer/**/*.zip
installer/**/*.log

# Keep source, assets, solution, and project metadata tracked
!README.md
!RELEASE.MD
!Directory.Build.props
!GetIt.sln
!**/*.cs
!**/*.xaml
!**/*.axaml
!**/*.csproj
!**/*.props
!**/*.targets
!**/*.config
