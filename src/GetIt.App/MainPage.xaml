<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GetIt_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:GetIt_App"
    xmlns:viewModels="using:GetIt_App.ViewModels"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    mc:Ignorable="d"
    NavigationCacheMode="Required"
    Background="Transparent">
    
    <Page.Resources>
        <ResourceDictionary>

            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource AppAccentTextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource AppSurfaceBrush}">

        <!-- Use a Grid to allow ListView to take up remaining space and push the action buttons to the bottom -->
        <Grid MaxWidth="1120" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="24,18,24,20" RowSpacing="14" Loaded="Page_Loaded">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2"><TextBlock Text="Baixar Vídeos" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource AppTextBrush}" /><TextBlock Text="Cole o link do vídeo, escolha o formato e comece o download." TextWrapping="Wrap" FontSize="14" Foreground="{ThemeResource AppSecondaryTextBrush}" /></StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.QueueSummary, Mode=OneWay}" Foreground="{ThemeResource AppSecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="180" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1" Background="{ThemeResource AppCardBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1" 
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.Transitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                        </TransitionCollection>
                    </Grid.Transitions>
                    <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="0" />
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="UrlTextBox" AutomationProperties.Name="Link da mídia" ToolTipService.ToolTip="Ctrl+L: focar link. Enter: adicionar. Ctrl+Enter: baixar fila." PlaceholderText="Cole ou digite um link de vídeo"
                                     Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     KeyDown="UrlTextBox_KeyDown"
                                     IsEnabled="{x:Bind ViewModel.IsNotDownloading, Mode=OneWay}" 
                                     CornerRadius="8" Padding="14,10" FontSize="14"
                                     Background="{ThemeResource AppInputBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1"
                                     Foreground="{ThemeResource AppTextBrush}"/>

                            <Button Grid.Column="1" Click="Paste_Click" IsEnabled="{x:Bind ViewModel.IsNotDownloading, Mode=OneWay}" CornerRadius="8" Padding="10" HorizontalAlignment="Stretch" ToolTipService.ToolTip="Colar link da área de transferência" AutomationProperties.Name="Colar link">
                                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE77F;" FontSize="14" /><TextBlock Text="Colar" /></StackPanel>
                            </Button>
                                <Button x:Name="AddUrlButton" Grid.Column="2" Command="{x:Bind ViewModel.AddUrlCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanAddUrl, Mode=OneWay}"
                                    CornerRadius="8" Padding="12,10" FontWeight="SemiBold" HorizontalAlignment="Stretch"
                                    Background="{ThemeResource AppAccentBrush}" Foreground="{ThemeResource AppAccentTextBrush}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="15" />
                                    <TextBlock Text="Adicionar" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Command="{x:Bind ViewModel.ClearQueueCommand}"
                                    Visibility="{x:Bind ViewModel.HasItemsVisibility, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanClearQueue, Mode=OneWay}" AutomationProperties.Name="Limpar fila" ToolTipService.ToolTip="Limpar fila" Padding="10" CornerRadius="8"
                                    Background="{ThemeResource AppInputBrush}" Foreground="{ThemeResource AppTextBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.InputError, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource AppErrorBrush}" />
                <ToggleSwitch IsOn="{x:Bind ViewModel.IsAutoPasteEnabled, Mode=TwoWay}"
                              Header="Preencher com links copiados do YouTube" OffContent="Desativado"
                              OnContent="Ativado" FontSize="12" />
            </StackPanel>

            <StackPanel Grid.Row="3" x:Name="EmptyQueueState" Visibility="{x:Bind ViewModel.IsQueueEmptyVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource AppAccentBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Sua fila está vazia" FontSize="18" FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Adicione um link acima para ver as opções de formato e qualidade."
                           FontSize="13" Foreground="{ThemeResource AppSecondaryTextBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>

            <!-- Only the queue scrolls; the destination and primary actions stay anchored below it. -->
            <ListView Grid.Row="3"
                      ItemsSource="{x:Bind ViewModel.DownloadQueue, Mode=OneWay}"
                      CanReorderItems="{x:Bind ViewModel.IsNotDownloading, Mode=OneWay}"
                      CanDragItems="{x:Bind ViewModel.IsNotDownloading, Mode=OneWay}"
                      AllowDrop="True"
                      SelectionMode="None"
                      Visibility="{x:Bind ViewModel.HasItemsVisibility, Mode=OneWay}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.Transitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ListView.Transitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DownloadItemViewModel">
                        <Border Background="{ThemeResource AppCardBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                                <Border CornerRadius="6" Height="62" Background="{ThemeResource AppInputBrush}" VerticalAlignment="Top">
                                    <Image Source="{x:Bind ThumbnailImage, Mode=OneWay}" Stretch="UniformToFill" Visibility="{x:Bind HasMetadataVisibility, Mode=OneWay}" />
                                </Border>
                                <ProgressRing IsActive="{x:Bind IsFetching, Mode=OneWay}" Width="24" Height="24" VerticalAlignment="Top" Margin="0,19,0,0" Visibility="{x:Bind IsFetchingVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind DisplayTitle, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind DisplayTitle, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource AppTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <!-- Fixed slots reserve the right edge even when another action is hidden. -->
                                <Grid Grid.Column="2" ColumnSpacing="6" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="34" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                                    <Button Command="{x:Bind PrepareAnotherDownloadCommand}" Visibility="{x:Bind OpenLocationVisibility, Mode=OneWay}" IsEnabled="{x:Bind CanEditQueue, Mode=OneWay}" ToolTipService.ToolTip="Baixar em outro formato" AutomationProperties.Name="Baixar em outro formato" Width="34" Height="34" Padding="0" Background="{ThemeResource AppAccentBrush}" Foreground="{ThemeResource AppAccentTextBrush}" CornerRadius="8"><FontIcon Glyph="&#xE8AB;" FontSize="15" /></Button>
                                    <Button Grid.Column="1" Command="{x:Bind OpenLocationCommand}" Visibility="{x:Bind OpenLocationVisibility, Mode=OneWay}" ToolTipService.ToolTip="Mostrar na pasta" AutomationProperties.Name="Mostrar na pasta" Width="34" Height="34" Padding="0" Background="{ThemeResource AppAccentBrush}" Foreground="{ThemeResource AppAccentTextBrush}" CornerRadius="8"><FontIcon Glyph="&#xE8B7;" FontSize="15" /></Button>
                                    <Button Grid.Column="2" Command="{x:Bind RemoveCommand}" IsEnabled="{x:Bind CanEditQueue, Mode=OneWay}" ToolTipService.ToolTip="Remover da fila" AutomationProperties.Name="Remover da fila" Width="34" Height="34" Padding="0" Background="Transparent" Foreground="{ThemeResource AppSecondaryTextBrush}" CornerRadius="8" BorderThickness="0"><FontIcon Glyph="&#xE711;" FontSize="13" /></Button>
                                </Grid>
                                <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnSpacing="8" Visibility="{x:Bind HasMetadataVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="0" /></Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource AppInputBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton Content="MP4" IsChecked="{x:Bind IsMp4Selected, Mode=TwoWay}" IsEnabled="{x:Bind CanEditQueue, Mode=OneWay}" AutomationProperties.Name="Formato MP4" CornerRadius="10" Padding="8,4" MinWidth="0" FontSize="12" FontWeight="Bold" Background="Transparent" Foreground="{ThemeResource AppTextBrush}" />
                                            <ToggleButton Content="MOV" IsChecked="{x:Bind IsMovSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanEditQueue, Mode=OneWay}" AutomationProperties.Name="Formato MOV" CornerRadius="10" Padding="8,4" MinWidth="0" FontSize="12" FontWeight="Bold" Background="Transparent" Foreground="{ThemeResource AppTextBrush}" />
                                            <ToggleButton Content="MP3" IsChecked="{x:Bind IsMp3Selected, Mode=TwoWay}" IsEnabled="{x:Bind CanEditQueue, Mode=OneWay}" AutomationProperties.Name="Formato MP3" CornerRadius="10" Padding="8,4" MinWidth="0" FontSize="12" FontWeight="Bold" Background="Transparent" Foreground="{ThemeResource AppTextBrush}" />
                                            <ToggleButton Content="WAV" IsChecked="{x:Bind IsWavSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanEditQueue, Mode=OneWay}" AutomationProperties.Name="Formato WAV" CornerRadius="10" Padding="8,4" MinWidth="0" FontSize="12" FontWeight="Bold" Background="Transparent" Foreground="{ThemeResource AppTextBrush}" />
                                            <ToggleButton Content="FLAC" IsChecked="{x:Bind IsFlacSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanEditQueue, Mode=OneWay}" AutomationProperties.Name="Formato FLAC" CornerRadius="10" Padding="8,4" MinWidth="0" FontSize="12" FontWeight="Bold" Background="Transparent" Foreground="{ThemeResource AppTextBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <ComboBox Grid.Column="1" Visibility="{x:Bind IsVideoOptionsVisibility, Mode=OneWay}" ItemsSource="{x:Bind AvailableFormats, Mode=OneWay}" SelectedItem="{x:Bind SelectedFormat, Mode=TwoWay}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Qualidade do vídeo" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="12" Padding="10,4" Background="{ThemeResource AppInputBrush}" Foreground="{ThemeResource AppTextBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" IsEnabled="{x:Bind CanEditQueue, Mode=OneWay}" />
                                    <ComboBox Grid.Column="1" Visibility="{x:Bind IsMp3OptionsVisibility, Mode=OneWay}" ItemsSource="{x:Bind AvailableAudioBitrates, Mode=OneWay}" SelectedItem="{x:Bind SelectedAudioBitrate, Mode=TwoWay}" DisplayMemberPath="Name" AutomationProperties.Name="Qualidade do MP3" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="12" Padding="10,4" Background="{ThemeResource AppInputBrush}" Foreground="{ThemeResource AppTextBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" IsEnabled="{x:Bind CanEditQueue, Mode=OneWay}" />
                                </Grid>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Spacing="6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind StatusMessage, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="12" Foreground="{x:Bind StatusColor, Mode=OneWay}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Visibility="{x:Bind IsDownloadingVisibility, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind Speed, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" /><TextBlock Text="•" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" /><TextBlock Text="Faltam:" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" /><TextBlock Text="{x:Bind Eta, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="12" Visibility="{x:Bind IsDownloadingVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                        <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProgressText, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Download All Card -->
            <Border Grid.Row="4" Background="{ThemeResource AppCardBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1" 
                    CornerRadius="8"
                    Padding="8">
                
                    <Border Background="{ThemeResource AppInputBrush}" CornerRadius="6" Padding="10,8" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" MinWidth="0" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" Foreground="{ThemeResource AppAccentBrush}" FontSize="16" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Pasta de downloads" FontSize="10" Foreground="{ThemeResource AppSecondaryTextBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.DownloadFolder, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.DownloadFolder, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2" HorizontalAlignment="Stretch" Content="Mudar" Command="{x:Bind ViewModel.ChangeFolderCommand}" IsEnabled="{x:Bind ViewModel.CanChangeFolder, Mode=OneWay}" Background="{ThemeResource AppCardBrush}" Foreground="{ThemeResource AppTextBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" />
                            <Button Grid.Column="3" HorizontalAlignment="Stretch" Height="36" Command="{x:Bind ViewModel.DownloadAllCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanStartDownloads, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsNotDownloadingVisibility, Mode=OneWay}"
                                    Background="{ThemeResource AppAccentBrush}" Foreground="{ThemeResource AppAccentTextBrush}"
                                    CornerRadius="8" Padding="12,7" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.DownloadButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" HorizontalAlignment="Stretch" Height="36" Content="Parar downloads" Command="{x:Bind ViewModel.CancelAllCommand}"
                                    Visibility="{x:Bind ViewModel.IsDownloadingVisibility, Mode=OneWay}"
                                    Background="Transparent" Foreground="#EF4444" BorderThickness="0" CornerRadius="6" Padding="8,5" />
                        </Grid>
                    </Border>
            </Border>
            
        </Grid>
    </Grid>
</Page>
