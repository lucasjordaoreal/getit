<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.1.2</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GetIt_App</RootNamespace>
    <AssemblyName>GetIt</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AppInfo.cs;AppLogger.cs;Services\SettingsService.cs;Services\HistoryService.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GetIt.Core\GetIt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\SplashScreen.scale-200.png">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\LockScreenLogo.scale-200.png">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Square150x150Logo.scale-200.png">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Square44x44Logo.scale-200.png">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\StoreLogo.png">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\AppIcon.ico">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Wide310x150Logo.scale-200.png">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\tools\Engine\Bin\yt-dlp.exe')">
    <None Include="..\..\tools\Engine\Bin\yt-dlp.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>Engine\Bin\yt-dlp.exe</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Post-publish cleanup target: moves dependencies into Libs subfolder -->
  <Target Name="MoveDependencies" AfterTargets="Publish">
    <PropertyGroup>
      <TargetPubDir>$([System.IO.Path]::GetFullPath('$(PublishDir)').TrimEnd('\').TrimEnd('/'))</TargetPubDir>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\PostPublishCleanup.ps1&quot; -PublishDir &quot;$(TargetPubDir)&quot;" />
  </Target>

  <ItemGroup>
    <ThirdPartyLicenseFile Include="..\..\licenses\THIRD_PARTY_NOTICES.md" />
    <ThirdPartyLicenseFile Include="..\..\licenses\THIRD_PARTY_SOURCES.md" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\yt-dlp-UNLICENSE.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\yt-dlp-2026.08.19-THIRD-PARTY-LICENSES.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Deno-MIT-LICENSE.md" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\dotnet-runtime-LICENSE.TXT" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\dotnet-runtime-THIRD-PARTY-NOTICES.TXT" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\CommunityToolkit-Mvvm-8.4.2-LICENSE.md" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\CommunityToolkit-Mvvm-8.4.2-ThirdPartyNotices.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\System-Numerics-Tensors-9.0.0-LICENSE.TXT" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\System-Numerics-Tensors-9.0.0-THIRD-PARTY-NOTICES.TXT" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WebView2-1.0.3719.77-LICENSE.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WebView2-1.0.3719.77-NOTICE.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WindowsAppSDK-2.1.3-license.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WindowsAppSDK-2.1.3-NOTICE.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WindowsAppSDK-AI-2.1.10-license.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WindowsAppSDK-Base-2.0.4-license.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WindowsAppSDK-Base-2.0.4-NOTICE.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WindowsAppSDK-DWrite-2.1.0-license.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WindowsAppSDK-Foundation-2.0.21-license.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WindowsAppSDK-InteractiveExperiences-2.0.13-license.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WindowsAppSDK-ML-2.1.1-license.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WindowsAppSDK-ML-2.1.1-ThirdPartyNotices.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WindowsAppSDK-Runtime-2.1.3-license.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WindowsAppSDK-Runtime-2.1.3-NOTICE.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WindowsAppSDK-Widgets-2.0.5-license.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WindowsAppSDK-WinUI-2.1.0-license.txt" />
    <ThirdPartyLicenseFile Include="..\..\licenses\texts\Microsoft-WindowsAppSDK-WinUI-2.1.0-NOTICE.txt" />
  </ItemGroup>

  <Target Name="CopyThirdPartyLicenseDocumentsToBuildOutput" AfterTargets="Build">
    <Copy
      SourceFiles="@(ThirdPartyLicenseFile)"
      DestinationFiles="@(ThirdPartyLicenseFile->'$(OutDir)Licenses\%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyThirdPartyLicenseDocumentsToPublishOutput" AfterTargets="Publish">
    <Copy
      SourceFiles="@(ThirdPartyLicenseFile)"
      DestinationFiles="@(ThirdPartyLicenseFile->'$(PublishDir)Licenses\%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
