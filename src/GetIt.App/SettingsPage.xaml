<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GetIt_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24,20">
        <Grid MaxWidth="1280" HorizontalAlignment="Stretch" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Configurações" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource AppTextBrush}" />
                <TextBlock Text="Ajuste a aparência e mantenha os componentes atualizados."
                           FontSize="14" Foreground="{ThemeResource AppSecondaryTextBrush}" />
            </StackPanel>

            <Grid x:Name="SettingsCards" Grid.Row="1" ColumnSpacing="16" RowSpacing="16" HorizontalAlignment="Stretch">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="SettingsWindowSizeStates">
                        <VisualState x:Name="WideSettingsLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1000" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="AppearanceCard.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="AboutCard.(Grid.Row)" Value="1" />
                                <Setter Target="AboutCard.(Grid.Column)" Value="1" />
                                <Setter Target="AboutCard.(Grid.ColumnSpan)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="AppearanceCard" Grid.ColumnSpan="2" Background="{ThemeResource AppCardBrush}" BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Aparência" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
                        <InfoBar x:Name="PersistenceStatusInfoBar" IsOpen="False" IsClosable="True"
                                 Closed="PersistenceStatusInfoBar_Closed" />
                        <ToggleSwitch x:Name="ThemeToggle" Header="Tema claro" OffContent="Escuro" OnContent="Claro"
                                      Toggled="ThemeToggle_Toggled" />
                        <Border Height="1" Background="{ThemeResource AppBorderBrush}" />
                        <StackPanel Spacing="12">
                            <TextBlock Text="Atualizações" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
                            <ToggleSwitch x:Name="AppAutoUpdateToggle" Header="Atualizar o GetIt automaticamente"
                                          OffContent="Desativado" OnContent="Ativado"
                                          Toggled="AppAutoUpdateToggle_Toggled" />
                            <TextBlock Text="Quando houver uma nova versão, o GetIt avisará e pedirá confirmação antes de instalar."
                                       FontSize="13" Foreground="{ThemeResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="YtDlpAutoUpdateToggle" Header="Atualizar o yt-dlp automaticamente"
                                          OffContent="Desativado" OnContent="Ativado"
                                          Toggled="YtDlpAutoUpdateToggle_Toggled" />
                            <TextBlock Text="O yt-dlp será verificado e atualizado ao iniciar o aplicativo."
                                       FontSize="13" Foreground="{ThemeResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Button x:Name="CheckAppUpdateButton" Content="Verificar atualização do GetIt"
                                        Click="CheckAppUpdate_Click" MinWidth="220" MinHeight="40" />
                                <ProgressRing x:Name="AppUpdateProgressRing" Width="20" Height="20" IsActive="False"
                                              Visibility="Collapsed" />
                            </StackPanel>
                            <InfoBar x:Name="AppUpdateStatusInfoBar" IsOpen="False" IsClosable="False" />
                            <StackPanel Spacing="5">
                                <TextBlock x:Name="YtDlpInstalledVersionText" Text="yt-dlp instalado: verificando…" FontSize="13" Foreground="{ThemeResource AppTextBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="YtDlpLatestVersionText" Text="Última versão estável: verificando…" FontSize="13" Foreground="{ThemeResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Button x:Name="UpdateButton" Content="Verificar versão do yt-dlp"
                                        Click="UpdateYtDlp_Click" MinHeight="40" />
                                <ProgressRing x:Name="UpdateProgressRing" Width="20" Height="20" IsActive="False"
                                              Visibility="Collapsed" />
                            </StackPanel>
                            <Button x:Name="InstallYtDlpUpdateButton" Content="Atualizar yt-dlp" Click="InstallYtDlpUpdate_Click"
                                    Visibility="Collapsed" MinHeight="40" HorizontalAlignment="Left" Background="{ThemeResource AppAccentBrush}"
                                    Foreground="{ThemeResource AppAccentTextBrush}" />
                            <InfoBar x:Name="UpdateStatusInfoBar" IsOpen="False" IsClosable="False" />
                            <Border Height="1" Background="{ThemeResource AppBorderBrush}" Margin="0,8" />
                            <TextBlock Text="Fila de downloads" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextBrush}" />
                            <ToggleSwitch x:Name="RestoreQueueToggle" Header="Restaurar fila ao iniciar"
                                          OffContent="Desativado" OnContent="Ativado"
                                          Toggled="RestoreQueueToggle_Toggled" />
                            <TextBlock Text="Permite recuperar links e preferências de downloads pendentes quando você abrir o GetIt novamente."
                                       FontSize="13" Foreground="{ThemeResource AppSecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="AboutCard" Grid.Row="1" Grid.ColumnSpan="2" Background="{ThemeResource AppCardBrush}" BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Sobre" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
                        <TextBlock x:Name="AppVersionText" FontSize="14" Foreground="{ThemeResource AppTextBrush}" />
                        <TextBlock Text="Desenvolvido por Lucas Jordão" FontSize="13"
                                   Foreground="{ThemeResource AppSecondaryTextBrush}" TextWrapping="Wrap" />
                        <HyperlinkButton Content="GitHub do GetIt"
                                         NavigateUri="https://github.com/lucasjordaoreal/getit"
                                         HorizontalAlignment="Left" />
                        <Button Content="Licenças de terceiros"
                                Click="OpenThirdPartyLicenses_Click"
                                HorizontalAlignment="Left" />
                        <InfoBar x:Name="LicenseOpenStatusInfoBar" IsOpen="False" IsClosable="True" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
