<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GetIt_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:GetIt_App"
    xmlns:viewModels="using:GetIt_App.ViewModels"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    mc:Ignorable="d"
    Background="Transparent">
    
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#050505" />
                    <Color x:Key="Glow1Color">#0A84FF</Color>
                    <Color x:Key="Glow2Color">#A259FF</Color>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#40000000" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9CA3AF" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#111" />
                    <SolidColorBrush x:Key="InputBorderBrush" Color="#333" />
                    <SolidColorBrush x:Key="AccentButtonBgBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="AccentButtonFgBrush" Color="White" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- Frutiger Aero Theme -->
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#D6EAF8" />
                    <Color x:Key="Glow1Color">#2ECC71</Color> <!-- Grass Green -->
                    <Color x:Key="Glow2Color">#85C1E9</Color> <!-- Sky Blue -->
                    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#90FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#40FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#D0FFFFFF" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#154360" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#2874A6" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#EBF5FB" />
                    <SolidColorBrush x:Key="InputBorderBrush" Color="#AED6F1" />
                    <LinearGradientBrush x:Key="AccentButtonBgBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#85C1E9" Offset="0.0"/>
                        <GradientStop Color="#3498DB" Offset="0.49"/>
                        <GradientStop Color="#2980B9" Offset="0.5"/>
                        <GradientStop Color="#1F618D" Offset="1.0"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="AccentButtonFgBrush" Color="White" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentButtonBgBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource AccentButtonFgBrush}" />
                <Setter Property="BorderBrush" Value="#80FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}">

        <!-- Use a Grid to allow ListView to take up remaining space and push the action buttons to the bottom -->
        <Grid MaxWidth="720" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="32,48,32,32" RowSpacing="24" Loaded="Page_Loaded">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Title -->
                <RowDefinition Height="Auto" /> <!-- Input -->
                <RowDefinition Height="*" />    <!-- ListView -->
                <RowDefinition Height="Auto" /> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- Title & Settings -->
            <Grid Grid.Row="0" Margin="0,0,0,-8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleSwitch Header="Tema" OffContent="Dark" OnContent="Light" Toggled="ThemeToggle_Toggled" Foreground="{ThemeResource PrimaryTextBrush}" />
                <TextBlock Grid.Column="1" Text="GetIt" FontWeight="ExtraBold" FontSize="44" Foreground="{ThemeResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnUpdate" Content="Verificar Atualizações"
                            Background="Transparent" Foreground="{ThemeResource PrimaryTextBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,8" FontWeight="SemiBold"
                            Click="CheckUpdate_Click">
                    </Button>
                    <Button Content="Histórico"
                            Background="{ThemeResource CardBackgroundBrush}" Foreground="{ThemeResource PrimaryTextBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16,8" FontWeight="Bold"
                            Click="HistoryButton_Click">
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Input Area Card -->
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundBrush}" 
                    BorderBrush="{ThemeResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="28"
                    Padding="32">
                <Grid>
                    <Grid.Transitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                        </TransitionCollection>
                    </Grid.Transitions>
                    <StackPanel Spacing="16">
                        <Grid Margin="4,0,0,-8">
                            <TextBlock Text="COLE A URL AQUI" FontWeight="ExtraBold" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center" />
                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsQueueMode, Mode=TwoWay}" 
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          OffContent="Link Único" OnContent="Modo Fila"
                                          Foreground="#9CA3AF" FontWeight="Bold"/>
                        </Grid>
                        
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBox PlaceholderText="Ex: https://www.youtube.com/watch?v=..." 
                                     Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{x:Bind ViewModel.IsNotDownloading, Mode=OneWay}" 
                                     CornerRadius="24" Padding="20,16" FontSize="16" FontWeight="SemiBold"
                                     Background="{ThemeResource InputBackgroundBrush}" BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1"
                                     Foreground="{ThemeResource PrimaryTextBrush}"/>

                            <Button Grid.Column="1" 
                                    Command="{x:Bind ViewModel.ClearQueueCommand}" 
                                    Content="{x:Bind ViewModel.QueueClearText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasItemsVisibility, Mode=OneWay}"
                                    CornerRadius="24" Padding="24,16" FontWeight="Bold" FontSize="16"
                                    Background="White" Foreground="#1A1A1A" BorderThickness="0"
                                    VerticalAlignment="Center"
                                    PointerEntered="Button_PointerEntered"
                                    PointerExited="Button_PointerExited">
                                <Button.Transitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition FromHorizontalOffset="20" />
                                    </TransitionCollection>
                                </Button.Transitions>
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="White" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1A1A1A" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="White" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#1A1A1A" />
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Download Queue ListView (Hidden scrollbar but scrollable) -->
            <ListView Grid.Row="2"
                      ItemsSource="{x:Bind ViewModel.DownloadQueue, Mode=OneWay}"
                      CanReorderItems="True"
                      CanDragItems="True"
                      AllowDrop="True"
                      SelectionMode="None"
                      Visibility="{x:Bind ViewModel.HasItemsVisibility, Mode=OneWay}"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.Transitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ListView.Transitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DownloadItemViewModel">
                        <!-- Mini Card -->
                        <Border Background="{ThemeResource CardBackgroundBrush}" 
                                BorderBrush="{ThemeResource CardBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="20"
                                Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail -->
                                <Border CornerRadius="12" Width="100" Height="56" Background="#111" VerticalAlignment="Center">
                                    <Image Source="{x:Bind Metadata.Thumbnail, Mode=OneWay}" Stretch="UniformToFill" 
                                           Visibility="{x:Bind HasMetadataVisibility, Mode=OneWay}"/>
                                </Border>
                                <ProgressRing Grid.Column="0" IsActive="True" Width="24" Height="24" Visibility="{x:Bind IsFetchingVisibility, Mode=OneWay}" />

                                <!-- Info & Controls -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock Text="{x:Bind Metadata.Title, Mode=OneWay}" 
                                               FontWeight="Bold" FontSize="14" Foreground="{ThemeResource PrimaryTextBrush}" 
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    
                                    <Grid ColumnSpacing="8" Visibility="{x:Bind HasMetadataVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Type Toggle -->
                                        <Border Background="{ThemeResource InputBackgroundBrush}" BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="2" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton Content="MP4" IsChecked="{x:Bind IsMp4Selected, Mode=TwoWay}" 
                                                              CornerRadius="10" Padding="12,4" FontSize="12" FontWeight="Bold" Background="Transparent" Foreground="{ThemeResource PrimaryTextBrush}" />
                                                <ToggleButton Content="MOV" IsChecked="{x:Bind IsMovSelected, Mode=TwoWay}" 
                                                              CornerRadius="10" Padding="12,4" FontSize="12" FontWeight="Bold" Background="Transparent" Foreground="{ThemeResource PrimaryTextBrush}" />
                                                <ToggleButton Content="ÁUDIO" IsChecked="{x:Bind IsAudioSelected, Mode=TwoWay}" 
                                                              CornerRadius="10" Padding="12,4" FontSize="12" FontWeight="Bold" Background="Transparent" Foreground="{ThemeResource PrimaryTextBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Quality Dropdown -->
                                        <ComboBox Grid.Column="1"
                                                  Visibility="{x:Bind IsVideoOptionsVisibility, Mode=OneWay}"
                                                  ItemsSource="{x:Bind AvailableFormats, Mode=OneWay}" 
                                                  SelectedItem="{x:Bind SelectedFormat, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="12" Padding="12,4" Background="{ThemeResource InputBackgroundBrush}" Foreground="{ThemeResource PrimaryTextBrush}" BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1"
                                                  IsEnabled="{x:Bind IsNotDownloading, Mode=OneWay}" />

                                        <ComboBox Grid.Column="1"
                                                  Visibility="{x:Bind IsAudioOptionsVisibility, Mode=OneWay}"
                                                  ItemsSource="{x:Bind AvailableAudioBitrates, Mode=OneWay}" 
                                                  SelectedItem="{x:Bind SelectedAudioBitrate, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="12" Padding="12,4" Background="{ThemeResource InputBackgroundBrush}" Foreground="{ThemeResource PrimaryTextBrush}" BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1"
                                                  IsEnabled="{x:Bind IsNotDownloading, Mode=OneWay}" />
                                    </Grid>

                                    <!-- Status / Progress -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}" 
                                                   FontWeight="SemiBold" FontSize="12" Foreground="{x:Bind StatusColor, Mode=OneWay}" />
                                        <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" 
                                                     Maximum="100" 
                                                     Width="100"
                                                     VerticalAlignment="Center"
                                                     Visibility="{x:Bind IsDownloadingVisibility, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Command="{x:Bind OpenLocationCommand}" 
                                            Visibility="{x:Bind OpenLocationVisibility, Mode=OneWay}"
                                            Background="#EAB308" Foreground="#1A1A1A" CornerRadius="12" Padding="12,8" FontWeight="Bold">
                                        Pasta
                                    </Button>
                                    <Button Command="{x:Bind RemoveCommand}" 
                                            Visibility="{x:Bind RemoveVisibility, Mode=OneWay}"
                                            IsEnabled="{x:Bind IsNotDownloading, Mode=OneWay}"
                                            Background="#3F1111" Foreground="#EF4444" CornerRadius="12" Padding="12,8" FontWeight="Bold" BorderThickness="0">
                                        X
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3F1111" />
                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#EF4444" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3F1111" />
                                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#EF4444" />
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Download All Card -->
            <Border Grid.Row="3" Background="{ThemeResource CardBackgroundBrush}" 
                    BorderBrush="{ThemeResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="28"
                    Padding="24"
                    Visibility="{x:Bind ViewModel.HasItemsVisibility, Mode=OneWay}">
                
                <StackPanel Spacing="16">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                        </TransitionCollection>
                    </StackPanel.Transitions>

                    <!-- Destination Folder Selector -->
                    <Border Background="{ThemeResource InputBackgroundBrush}" CornerRadius="16" Padding="16,12" BorderBrush="{ThemeResource InputBorderBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Salvar em:" Foreground="{ThemeResource SecondaryTextBrush}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DownloadFolder, Mode=OneWay}" Foreground="{ThemeResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Content="Mudar" Command="{x:Bind ViewModel.ChangeFolderCommand}" Background="{ThemeResource CardBackgroundBrush}" Foreground="{ThemeResource PrimaryTextBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" />
                        </Grid>
                    </Border>
                    
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Content="{x:Bind ViewModel.QueueDownloadText, Mode=OneWay}" 
                            Command="{x:Bind ViewModel.DownloadAllCommand}" 
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.IsNotDownloading, Mode=OneWay}" 
                            CornerRadius="20" Padding="0,16" FontWeight="Bold" FontSize="15"
                            PointerEntered="Button_PointerEntered"
                            PointerExited="Button_PointerExited">
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0A84FF" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0A84FF" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <LinearGradientBrush x:Key="ButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#85C1E9" Offset="0.0"/>
                                            <GradientStop Color="#3498DB" Offset="0.49"/>
                                            <GradientStop Color="#2980B9" Offset="0.5"/>
                                            <GradientStop Color="#1F618D" Offset="1.0"/>
                                        </LinearGradientBrush>
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                        <LinearGradientBrush x:Key="ButtonBackgroundPressed" StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#85C1E9" Offset="0.0"/>
                                            <GradientStop Color="#3498DB" Offset="0.49"/>
                                            <GradientStop Color="#2980B9" Offset="0.5"/>
                                            <GradientStop Color="#1F618D" Offset="1.0"/>
                                        </LinearGradientBrush>
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                    </Button>

                    <Button Content="Parar Todos" 
                            Command="{x:Bind ViewModel.CancelAllCommand}" 
                            Grid.Column="1"
                            Visibility="{x:Bind ViewModel.IsDownloadingVisibility, Mode=OneWay}" 
                            CornerRadius="20" Padding="24,16" FontWeight="Bold" FontSize="15" Background="#3F1111" Foreground="#EF4444" BorderThickness="0"
                            PointerEntered="Button_PointerEntered"
                            PointerExited="Button_PointerExited" />
                    </Grid>
                </StackPanel>
            </Border>
            
        </Grid>
    </Grid>
</Page>

