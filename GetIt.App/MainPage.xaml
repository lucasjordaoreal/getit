<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GetIt_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:GetIt_App"
    xmlns:viewModels="using:GetIt_App.ViewModels"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    mc:Ignorable="d"
    Background="Transparent">
    
    <Page.Resources>
        <ResourceDictionary>

            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource AppAccentTextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppAccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource AppSurfaceBrush}">

        <!-- Use a Grid to allow ListView to take up remaining space and push the action buttons to the bottom -->
        <Grid MaxWidth="1120" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="24,18,24,20" RowSpacing="14" Loaded="Page_Loaded">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Text="Baixar Vídeos" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource AppTextBrush}" />
                <TextBlock Text="Cole o link do vídeo, escolha o formato e comece o download."
                           FontSize="14" Foreground="{ThemeResource AppSecondaryTextBrush}" />
            </StackPanel>

            <Border Grid.Row="1" Background="{ThemeResource AppCardBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1" 
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.Transitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                        </TransitionCollection>
                    </Grid.Transitions>
                    <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <TextBox PlaceholderText="Cole ou digite um link de vídeo"
                                     Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     KeyDown="UrlTextBox_KeyDown"
                                     IsEnabled="{x:Bind ViewModel.IsNotDownloading, Mode=OneWay}" 
                                     CornerRadius="8" Padding="14,10" FontSize="14"
                                     Background="{ThemeResource AppInputBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1"
                                     Foreground="{ThemeResource AppTextBrush}"/>

                                <Button Grid.Column="1" Command="{x:Bind ViewModel.AddUrlCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanAddUrl, Mode=OneWay}"
                                    CornerRadius="8" Padding="18,10" FontWeight="SemiBold"
                                    Background="{ThemeResource AppAccentBrush}" Foreground="{ThemeResource AppAccentTextBrush}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="15" />
                                    <TextBlock Text="Adicionar" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{x:Bind ViewModel.ClearQueueCommand}"
                                    Visibility="{x:Bind ViewModel.HasItemsVisibility, Mode=OneWay}"
                                    ToolTipService.ToolTip="Limpar fila" Padding="10" CornerRadius="8"
                                    Background="{ThemeResource AppInputBrush}" Foreground="{ThemeResource AppTextBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.InputError, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AppErrorBrush}" />
                <ToggleSwitch IsOn="{x:Bind ViewModel.IsAutoPasteEnabled, Mode=TwoWay}"
                              Header="Preencher com links copiados do YouTube" OffContent="Desativado"
                              OnContent="Ativado" FontSize="12" />
            </StackPanel>

            <StackPanel Grid.Row="3" x:Name="EmptyQueueState" Visibility="{x:Bind ViewModel.IsQueueEmptyVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource AppAccentBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Sua fila está vazia" FontSize="18" FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Adicione um link acima para ver as opções de formato e qualidade."
                           FontSize="13" Foreground="{ThemeResource AppSecondaryTextBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
            </StackPanel>

            <!-- Download Queue ListView (Hidden scrollbar but scrollable) -->
            <ListView Grid.Row="3"
                      ItemsSource="{x:Bind ViewModel.DownloadQueue, Mode=OneWay}"
                      CanReorderItems="True"
                      CanDragItems="True"
                      AllowDrop="True"
                      SelectionMode="None"
                      Visibility="{x:Bind ViewModel.HasItemsVisibility, Mode=OneWay}"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.Transitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ListView.Transitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DownloadItemViewModel">
                        <!-- Mini Card -->
                        <Border Background="{ThemeResource AppCardBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                                BorderThickness="1" 
                                CornerRadius="8"
                                Padding="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail -->
                                <Border CornerRadius="6" Width="100" Height="62" Background="{ThemeResource AppInputBrush}" VerticalAlignment="Center">
                                    <Image Source="{x:Bind Metadata.Thumbnail, Mode=OneWay}" Stretch="UniformToFill" 
                                           Visibility="{x:Bind HasMetadataVisibility, Mode=OneWay}"/>
                                </Border>
                                <ProgressRing Grid.Column="0" IsActive="True" Width="24" Height="24" Visibility="{x:Bind IsFetchingVisibility, Mode=OneWay}" />

                                <!-- Info & Controls -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock Text="{x:Bind Metadata.Title, Mode=OneWay}" 
                                               FontWeight="Bold" FontSize="14" Foreground="{ThemeResource AppTextBrush}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    
                                    <Grid ColumnSpacing="8" Visibility="{x:Bind HasMetadataVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Type Toggle -->
                                        <Border Background="{ThemeResource AppInputBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="2" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton Content="MP4" IsChecked="{x:Bind IsMp4Selected, Mode=TwoWay}" 
                                                              CornerRadius="10" Padding="12,4" FontSize="12" FontWeight="Bold" Background="Transparent" Foreground="{ThemeResource AppTextBrush}" />
                                                <ToggleButton Content="MOV" IsChecked="{x:Bind IsMovSelected, Mode=TwoWay}" 
                                                              CornerRadius="10" Padding="12,4" FontSize="12" FontWeight="Bold" Background="Transparent" Foreground="{ThemeResource AppTextBrush}" />
                                                <ToggleButton Content="ÁUDIO" IsChecked="{x:Bind IsAudioSelected, Mode=TwoWay}" 
                                                              CornerRadius="10" Padding="12,4" FontSize="12" FontWeight="Bold" Background="Transparent" Foreground="{ThemeResource AppTextBrush}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Quality Dropdown -->
                                        <ComboBox Grid.Column="1"
                                                  Visibility="{x:Bind IsVideoOptionsVisibility, Mode=OneWay}"
                                                  ItemsSource="{x:Bind AvailableFormats, Mode=OneWay}" 
                                                  SelectedItem="{x:Bind SelectedFormat, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="12" Padding="12,4" Background="{ThemeResource AppInputBrush}" Foreground="{ThemeResource AppTextBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1"
                                                  IsEnabled="{x:Bind IsNotDownloading, Mode=OneWay}" />

                                        <ComboBox Grid.Column="1"
                                                  Visibility="{x:Bind IsAudioOptionsVisibility, Mode=OneWay}"
                                                  ItemsSource="{x:Bind AvailableAudioBitrates, Mode=OneWay}" 
                                                  SelectedItem="{x:Bind SelectedAudioBitrate, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"
                                                  HorizontalAlignment="Stretch"
                                                  CornerRadius="12" Padding="12,4" Background="{ThemeResource AppInputBrush}" Foreground="{ThemeResource AppTextBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1"
                                                  IsEnabled="{x:Bind IsNotDownloading, Mode=OneWay}" />
                                    </Grid>

                                    <!-- Status / Progress -->
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}" 
                                                       FontWeight="SemiBold" FontSize="12" Foreground="{x:Bind StatusColor, Mode=OneWay}" />
                                            
                                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind IsDownloadingVisibility, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind Speed, Mode=OneWay}" 
                                                           FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="Faltam:" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind Eta, Mode=OneWay}" 
                                                           FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid ColumnSpacing="12" Visibility="{x:Bind IsDownloadingVisibility, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" 
                                                         Maximum="100" 
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ProgressText, Mode=OneWay}" 
                                                       FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AppTextBrush}"
                                                       VerticalAlignment="Center" MinWidth="35" TextAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Command="{x:Bind PrepareAnotherDownloadCommand}"
                                            Visibility="{x:Bind OpenLocationVisibility, Mode=OneWay}"
                                            IsEnabled="{x:Bind CanEditQueue, Mode=OneWay}"
                                            Background="{ThemeResource AppAccentBrush}" Foreground="{ThemeResource AppAccentTextBrush}"
                                            CornerRadius="12" Padding="12,8" FontWeight="Bold">
                                        Outro formato
                                    </Button>
                                    <Button Command="{x:Bind OpenLocationCommand}" 
                                            Visibility="{x:Bind OpenLocationVisibility, Mode=OneWay}"
                                            Background="{ThemeResource AppAccentBrush}" Foreground="{ThemeResource AppAccentTextBrush}" CornerRadius="8" Padding="10,8" FontWeight="SemiBold"
                                            ToolTipService.ToolTip="Abrir pasta">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    </Button>
                                    <Button Command="{x:Bind RemoveCommand}" 
                                            IsEnabled="{x:Bind CanEditQueue, Mode=OneWay}"
                                            Background="Transparent" Foreground="{ThemeResource AppSecondaryTextBrush}" CornerRadius="8" Padding="10,8" FontWeight="Bold" BorderThickness="0"
                                            ToolTipService.ToolTip="Remover da fila">
                                        <FontIcon Glyph="&#xE711;" FontSize="13" />
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#332A7FFF" />
                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#EF4444" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#332A7FFF" />
                                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#EF4444" />
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Download All Card -->
            <Border Grid.Row="4" Background="{ThemeResource AppCardBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1" 
                    CornerRadius="8"
                    Padding="8">
                
                    <Border Background="{ThemeResource AppInputBrush}" CornerRadius="6" Padding="10,8" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" Foreground="{ThemeResource AppAccentBrush}" FontSize="16" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Pasta de downloads" FontSize="10" Foreground="{ThemeResource AppSecondaryTextBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.DownloadFolder, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Mudar" Command="{x:Bind ViewModel.ChangeFolderCommand}" Background="{ThemeResource AppCardBrush}" Foreground="{ThemeResource AppTextBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" />
                            <Button Grid.Column="3" Command="{x:Bind ViewModel.DownloadAllCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanStartDownloads, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasItemsVisibility, Mode=OneWay}"
                                    Background="{ThemeResource AppAccentBrush}" Foreground="{ThemeResource AppAccentTextBrush}"
                                    CornerRadius="8" Padding="12,7" FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="Baixar fila" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="4" Content="Parar downloads" Command="{x:Bind ViewModel.CancelAllCommand}"
                                    Visibility="{x:Bind ViewModel.IsDownloadingVisibility, Mode=OneWay}"
                                    Background="Transparent" Foreground="#EF4444" BorderThickness="0" CornerRadius="6" Padding="8,5" />
                        </Grid>
                    </Border>
            </Border>
            
        </Grid>
    </Grid>
</Page>

