<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="GetIt_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GetIt_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    Title="GetIt"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <media:MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource AppSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <muxc:TitleBar x:Name="AppTitleBar" Title="GetIt" />

        <muxc:NavigationView x:Name="NavView"
                            Grid.Row="1"
                            IsBackButtonVisible="Collapsed"
                            IsPaneOpen="True"
                            IsSettingsVisible="True"
                            OpenPaneLength="236"
                            CompactPaneLength="52"
                            PaneDisplayMode="Auto"
                            PaneTitle="GetIt"
                            SelectionChanged="NavView_SelectionChanged"
                            Loaded="NavView_Loaded"
                            Background="Transparent"
                            BorderThickness="0">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Tag="Home" Content="Baixar" ToolTipService.ToolTip="Baixar">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Tag="History" Content="Histórico" ToolTipService.ToolTip="Histórico">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>
            <Frame x:Name="RootFrame" Background="Transparent" />
        </muxc:NavigationView>
    </Grid>
</Window>
