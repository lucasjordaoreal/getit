<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GetIt_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Margin="24">
        <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Stretch">
            <TextBlock Text="Configurações" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource AppTextBrush}" />

            <Border Background="{ThemeResource AppCardBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="16">
                    <TextBlock Text="Geral" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
                    
                    <ToggleSwitch x:Name="ThemeToggle" Header="Modo Claro" OffContent="Desativado" OnContent="Ativado" Toggled="ThemeToggle_Toggled" />
                    
                    <Button Content="Forçar atualização do yt-dlp" Click="UpdateYtDlp_Click" />
                    <TextBlock x:Name="UpdateStatusText" Foreground="{ThemeResource AppSecondaryTextBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
