<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GetIt_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Margin="32">
        <StackPanel Spacing="24">
            <TextBlock Text="Configurações" FontSize="32" FontWeight="Bold" />

            <Border Background="#20000000" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Geral" FontSize="20" FontWeight="SemiBold" />
                    
                    <ToggleSwitch x:Name="ThemeToggle" Header="Modo Claro" OffContent="Desativado" OnContent="Ativado" Toggled="ThemeToggle_Toggled" />
                    
                    <Button Content="Forçar atualização do yt-dlp" Click="UpdateYtDlp_Click" />
                    <TextBlock x:Name="UpdateStatusText" Foreground="Yellow" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
