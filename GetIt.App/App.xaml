<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="GetIt_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GetIt_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#007F73</Color>
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F1F4F5" />
                    <SolidColorBrush x:Key="AppPaneBrush" Color="#E9EFF0" />
                    <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppCardStrongBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#D7E0E2" />
                    <SolidColorBrush x:Key="AppInputBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#17272B" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#53696D" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#007F73" />
                    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSuccessBrush" Color="#008A62" />
                    <SolidColorBrush x:Key="AppErrorBrush" Color="#C63736" />
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F1F4F5" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#49C5A8</Color>
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#111A1B" />
                    <SolidColorBrush x:Key="AppPaneBrush" Color="#141F20" />
                    <SolidColorBrush x:Key="AppCardBrush" Color="#1B2829" />
                    <SolidColorBrush x:Key="AppCardStrongBrush" Color="#233233" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#344446" />
                    <SolidColorBrush x:Key="AppInputBrush" Color="#172324" />
                    <SolidColorBrush x:Key="AppTextBrush" Color="#E7F0EF" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#9FB3B2" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#49C5A8" />
                    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#0B2521" />
                    <SolidColorBrush x:Key="AppSuccessBrush" Color="#55C89B" />
                    <SolidColorBrush x:Key="AppErrorBrush" Color="#FF7B72" />
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#111A1B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

            <!-- Font settings globally -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable</FontFamily>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>

