<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="GetIt_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GetIt_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#0A84FF</Color>
                    <!-- Overriding native System colors for the Soft Tech palette -->
                    <Color x:Key="SystemAltHighColor">#F5F7FB</Color>
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#00F5F7FB" /> <!-- Transparent to show backdrop -->
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#0A84FF</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Aggressive rounding globally for all controls -->
            <CornerRadius x:Key="ControlCornerRadius">22</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">22</CornerRadius>

            <!-- Font settings globally -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable, Inter, San Francisco, Arial</FontFamily>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>

