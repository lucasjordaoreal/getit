<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="GetIt_App.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:GetIt_App.Services"
    mc:Ignorable="d"
    Title="Histórico e Player"
    Closed="Window_Closed">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#050505" />
                        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#20000000" />
                        <SolidColorBrush x:Key="CardBorderBrush" Color="#15FFFFFF" />
                        <SolidColorBrush x:Key="PrimaryTextBrush" Color="White" />
                        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#555" />
                        <SolidColorBrush x:Key="ItemBackgroundBrush" Color="#111" />
                        <SolidColorBrush x:Key="ItemBorderBrush" Color="#333" />
                        <SolidColorBrush x:Key="PlayerBackgroundBrush" Color="#000000" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <!-- Frutiger Aero Theme -->
                        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#D6EAF8" />
                        <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#90FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#40FFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                        <SolidColorBrush x:Key="CardBorderBrush" Color="#D0FFFFFF" />
                        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#154360" />
                        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#2874A6" />
                        <SolidColorBrush x:Key="ItemBackgroundBrush" Color="#EBF5FB" />
                        <SolidColorBrush x:Key="ItemBorderBrush" Color="#AED6F1" />
                        <SolidColorBrush x:Key="PlayerBackgroundBrush" Color="#FFFFFF" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid Background="{ThemeResource AppBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <!-- Left Side: History List -->
        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <Grid Margin="20,20,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Histórico" FontWeight="Bold" FontSize="24" Foreground="{ThemeResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Limpar" Click="ClearHistory_Click" Background="#3F1111" Foreground="#EF4444" CornerRadius="8" Padding="12,6" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Center">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3F1111" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#EF4444" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3F1111" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#EF4444" />
                        </Button.Resources>
                    </Button>
                </Grid>
                
                <ListView Grid.Row="1" x:Name="HistoryList" Margin="10" SelectionChanged="HistoryList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:HistoryItem">
                            <Border Background="{ThemeResource ItemBackgroundBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,8" BorderBrush="{ThemeResource ItemBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="Bold" Foreground="{ThemeResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                                    <TextBlock Text="{x:Bind Url}" FontSize="12" Foreground="#0A84FF" TextTrimming="CharacterEllipsis"/>
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                        <Button Content="Pasta" Click="OpenFolder_Click" Background="#EAB308" Foreground="#1A1A1A" CornerRadius="8" Padding="10,4" Tag="{x:Bind LocalFilePath}">
                                            <Button.Resources>
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#EAB308" />
                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1A1A1A" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#EAB308" />
                                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#1A1A1A" />
                                            </Button.Resources>
                                        </Button>
                                        <Button Content="Tocar" Click="PlayVideo_Click" Background="#0A84FF" Foreground="White" CornerRadius="8" Padding="10,4" Tag="{x:Bind LocalFilePath}">
                                            <Button.Resources>
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0A84FF" />
                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0A84FF" />
                                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Right Side: Player -->
        <Grid Grid.Column="1" Background="{ThemeResource PlayerBackgroundBrush}">
            <MediaPlayerElement x:Name="PlayerElement" AreTransportControlsEnabled="True" AutoPlay="True" />
            <TextBlock x:Name="NoVideoText" Text="Selecione um vídeo para reproduzir" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        </Grid>
    </Grid>
</Window>

