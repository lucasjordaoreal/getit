<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GetIt_App.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:GetIt_App.Services"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Side: History List -->
        <Border Grid.Column="0" Background="#20000000" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <Grid Margin="20,20,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Histórico" FontWeight="Bold" FontSize="24" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Limpar" Click="ClearHistory_Click" Background="#3F1111" Foreground="#EF4444" CornerRadius="8" Padding="12,6" FontWeight="Bold" BorderThickness="0" VerticalAlignment="Center" />
                </Grid>
                
                <ListView Grid.Row="1" x:Name="HistoryList" Margin="10">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:HistoryItem">
                            <Border Background="#111" CornerRadius="12" Padding="12" Margin="0,0,0,8" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                                    <TextBlock Text="{x:Bind Url}" FontSize="12" Foreground="#0A84FF" TextTrimming="CharacterEllipsis"/>
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                        <Button Content="Pasta" Click="OpenFolder_Click" Background="#EAB308" Foreground="#1A1A1A" CornerRadius="8" Padding="10,4" Tag="{x:Bind LocalFilePath}" />
                                        <Button Content="Tocar" Click="PlayVideo_Click" Background="#0A84FF" Foreground="White" CornerRadius="8" Padding="10,4" Tag="{x:Bind LocalFilePath}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Right Side: Player -->
        <Grid Grid.Column="1" Background="#000000">
            <MediaPlayerElement x:Name="PlayerElement" AreTransportControlsEnabled="True" AutoPlay="True" />
            <TextBlock x:Name="NoVideoText" Text="Selecione um vídeo para reproduzir" Foreground="#555" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
